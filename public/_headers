# Cloudflare Pages / Netlify / Vercel Header Rules
# -------------------------------------------------------------
# Security and Crawler Protection for Audio Assets:
# Exclude audio tracks from crawler indexing, search cache, and archiving.

/assets/music/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
