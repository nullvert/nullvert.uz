---
/**
 * Пользовательский компактный футер с ссылкой на Лицензии и поддержкой FooterConfig.html.
 */
import * as fs from "node:fs";
import * as path from "node:path";
import FooterBar from "@components/atoms/blog/FooterBar.astro";
import { url } from "@utils/url-utils";
import { footerConfig, profileConfig, siteConfig } from "@/config";

const currentYear = new Date().getFullYear();
const authorName = profileConfig.name || siteConfig.title || "Nullvert";
const links = [
	{ label: "Лицензии", href: url("credits-and-licenses/") },
	{ label: "RSS", href: url("rss/") },
	{ label: "Atom", href: url("atom/") },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
];
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{
		label: "Shirone",
		href: "https://github.com/LyraVoid/Shirone",
		external: true,
	},
];

let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		const footerConfigPath = [
			path.join(process.cwd(), "shirones", "config", "FooterConfig.html"),
			path.join(process.cwd(), "src", "config", "FooterConfig.html"),
		].find((candidate) => fs.existsSync(candidate));
		if (footerConfigPath) {
			const raw = fs.readFileSync(footerConfigPath, "utf-8");
			const cleaned = raw.replace(/<!--[\s\S]*?-->/g, "").trim();
			if (cleaned) {
				customFooterHtml = cleaned;
			}
		}
	} catch {
		customFooterHtml = "";
	}
}
---

<FooterBar
	name={authorName}
	year={currentYear}
	links={links}
	poweredBy={poweredBy}
	version="0.1.5"
	versionHref="https://github.com/LyraVoid/Shirone"
	customHtml={customFooterHtml}
/>

<style>
:global(.m3-blog-footer__divider) {
	border: none;
	height: 1px;
	background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--outline-variant) 60%, transparent), transparent);
	margin: 3rem auto 2rem;
	max-width: 90%;
}

:global(.m3-blog-footer__sep) {
	display: inline-block;
	margin: 0 0.5rem;
	font-size: 0;
}

:global(.m3-blog-footer__sep::before) {
	content: "·";
	font-size: 1rem;
	line-height: 1;
	color: color-mix(in srgb, var(--outline-variant) 70%, transparent);
}

:global(.m3-blog-footer__text) {
	font: var(--m3e-type-body-small);
	color: var(--on-surface-variant);
	letter-spacing: 0.01em;
}

:global(.m3-blog-footer__link) {
	color: var(--on-surface-variant);
	transition: color 150ms ease, opacity 150ms ease;
}

:global(.m3-blog-footer__link:hover) {
	color: var(--primary);
	opacity: 1;
}
</style>
