---
import { Icon } from "astro-icon/components";
import { url } from "@utils/url-utils";
---

<footer class="m3-blog-footer">
	<div class="m3-blog-footer__inner">
		<details class="m3-blog-footer__details group">
			<summary class="m3-blog-footer__summary">
				<span class="m3-blog-footer__copyright">&copy; All Rights Reserved</span>
				<Icon name="material-symbols:expand-more-rounded" class="m3-blog-footer__summary-icon" />
			</summary>
			<div class="m3-blog-footer__details-content">
				<div class="m3-blog-footer__row">
					<a class="m3-blog-footer__link" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>
					<span class="m3-blog-footer__sep" aria-hidden="true">·</span>
					<a class="m3-blog-footer__link" href={url("rss/")}>RSS</a>
					<span class="m3-blog-footer__sep" aria-hidden="true">·</span>
					<a class="m3-blog-footer__link" href={url("atom/")}>Atom</a>
					<span class="m3-blog-footer__sep" aria-hidden="true">·</span>
					<a class="m3-blog-footer__link" href={url("sitemap-index.xml")} target="_blank" rel="noopener noreferrer">Sitemap</a>
				</div>
				<div class="m3-blog-footer__row m3-blog-footer__powered">
					Powered by <a class="m3-blog-footer__link" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp; <a class="m3-blog-footer__link" href="https://github.com/LyraVoid/Shirone" target="_blank" rel="noopener noreferrer">Shirone</a>
					<span class="m3-blog-footer__sep" aria-hidden="true">·</span>
					<span>v0.1.5</span>
				</div>
			</div>
		</details>
	</div>
</footer>

<style>
.m3-blog-footer {
	width: 100%;
	margin-top: 1.5rem;
	margin-bottom: 0;
}



.m3-blog-footer__inner {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 0 0.5rem 1.5rem;
	text-align: center;
}

.m3-blog-footer__details {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%;
}

.m3-blog-footer__summary {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.25rem;
	cursor: pointer;
	list-style: none;
	user-select: none;
	font-size: 0.8rem;
	color: var(--on-surface-variant);
	opacity: 0.65;
	transition: opacity 150ms ease;
}

.m3-blog-footer__summary::-webkit-details-marker {
	display: none;
}

.m3-blog-footer__summary:hover {
	opacity: 1;
}

.m3-blog-footer__summary-icon {
	width: 1.1rem;
	height: 1.1rem;
	transition: transform 200ms ease;
}

.m3-blog-footer__details[open] .m3-blog-footer__summary-icon {
	transform: rotate(180deg);
}

.m3-blog-footer__details-content {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.35rem;
	margin-top: 0.5rem;
	width: 100%;
}

.m3-blog-footer__row {
	display: flex;
	align-items: center;
	justify-content: center;
	white-space: nowrap;
	font-size: 0.775rem;
	color: var(--on-surface-variant);
	line-height: 1.4;
}

.m3-blog-footer__powered {
	font-size: 0.72rem;
	opacity: 0.7;
}

.m3-blog-footer__sep {
	margin: 0 0.35rem;
	font-size: 0.75rem;
	opacity: 0.5;
	user-select: none;
}

.m3-blog-footer__link {
	color: inherit;
	text-decoration: none;
	transition: color 150ms ease;
}

.m3-blog-footer__link:hover {
	color: var(--primary);
}
</style>
