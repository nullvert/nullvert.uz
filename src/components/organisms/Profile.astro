---
import { getImage } from "astro:assets";
import Card from "@components/atoms/display/Card.svelte";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import { resolveImageAsset } from "@utils/asset-utils";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import type { ProfileWidget } from "@/types/sidebarConfig";

interface Props {
	class?: string;
	style?: string;
	widget?: ProfileWidget;
	priority?: boolean;
}

const className = Astro.props.class;
const style = Astro.props.style;
const priority = Astro.props.priority ?? false;

const config = profileConfig;
const avatarAsset = await resolveImageAsset(config.avatar ?? "");
let avatarUrl = typeof avatarAsset === "string" ? avatarAsset : avatarAsset.src;
let avatarSrcset: string | undefined;

if (typeof avatarAsset !== "string") {
	const widths = [128, 256].filter((w) => w <= avatarAsset.width);
	const candidates = await Promise.all(
		widths.map(async (width) => ({
			width,
			image: await getImage({
				src: avatarAsset,
				width,
				format: "webp",
				quality: 85,
			}),
		})),
	);
	avatarUrl =
		candidates.find(({ width }) => width === 256)?.image.src ??
		candidates.at(-1)?.image.src ??
		avatarAsset.src;
	avatarSrcset = candidates
		.map(({ image, width }) => `${image.src} ${width}w`)
		.join(", ");
}

const name = config.name || "nullvert";
const bio = config.bio || "Черновики и заметки";

const normalizeIcon = (linkName: string, icon: string) => {
	const n = linkName.toLowerCase();
	if (n.includes("tg") || n.includes("telegram")) return "fa6-brands:telegram";
	if (n.includes("github")) return "fa6-brands:github";
	if (n.includes("rss")) return "fa6-solid:rss";
	return icon || "fa6-solid:link";
};

const links = config.links.map((item) => ({
	...item,
	icon: normalizeIcon(item.name, item.icon),
}));
---

<div class:list={["m3-profile-root", className]} style={style}>
	<Card color="var(--card-bg)" radius="xl" class="m3-profile !p-4 !w-full">
		<div class="m3-profile__body flex flex-col gap-3.5 w-full">
			<!-- Верхняя часть: аватар + инфо -->
			<div class="flex items-center gap-3.5 w-full">
				<!-- Аватар: без рамки и отступов, изображение занимает всю плитку -->
				<div class="relative shrink-0">
					<div class="w-16 h-16 rounded-[16px] overflow-hidden">
						<img
							src={avatarUrl}
							srcset={avatarSrcset}
							alt={name}
							class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
							loading={priority ? "eager" : "lazy"}
							fetchpriority={priority ? "high" : undefined}
						/>
					</div>
				</div>

				<!-- Имя и био -->
				<div class="flex flex-col justify-center min-w-0">
					<span class="font-medium text-[1.125rem] leading-snug tracking-[0.05em] text-[var(--primary)] truncate">
						{name}
					</span>
					<p class="text-xs text-[var(--on-surface-variant)] mt-0.5 leading-normal truncate">
						{bio}
					</p>
				</div>
			</div>

			<!-- Нижняя часть: сетка ссылок (концентрический токен --shape-corner-m: 12px, адаптивный flex/grid) -->
			<div class="flex flex-wrap sm:grid sm:grid-cols-2 lg:grid-cols-2 gap-2 w-full pt-0.5">
				{links.map((item) => (
					<a
						href={item.url}
						target="_blank"
						rel="me noopener noreferrer"
						class="flex-1 min-w-[calc(50%-0.375rem)] sm:min-w-0 flex items-center justify-center gap-2 py-2 px-3 rounded-[var(--shape-corner-m)] m3-profile__link text-[var(--on-surface-variant)] hover:text-[var(--primary)] text-xs font-semibold tracking-tight transition-all duration-200 group/btn"
					>
						<Icon name={item.icon} class="text-sm shrink-0 transition-transform duration-200 group-hover/btn:scale-110 text-[var(--primary)]" />
						<span class="truncate">{item.name}</span>
					</a>
				))}
			</div>

			<UmamiStats variant="profile" />
		</div>
	</Card>
</div>

<style is:global>
	/* Стеклянная подсветка карточки при наведении: тонированная заливка и светлая рамка на заднем плане,
	   текст и кнопки остаются поверх и не меняются. */
	.m3-profile {
		position: relative;
		isolation: isolate;

	}
	.m3-profile::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		pointer-events: none;
		background:
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--primary) 26%, transparent),
				color-mix(in srgb, var(--primary) 12%, transparent)
			);
		box-shadow:
			inset 0 0 0 1px color-mix(in srgb, var(--primary) 55%, transparent),
			inset 0 1px 0 color-mix(in srgb, white 35%, transparent);
		opacity: 0;
		transition: opacity var(--m3e-duration-long) var(--m3e-easing-standard);
	}
		.m3-profile:hover::before {
		opacity: 1;
	}
		/* Стеклянные кнопки: утонченный glassmorphism, тонкая внутренняя рамка и блик */
	.m3-profile__link {
		position: relative;
		background: color-mix(in srgb, var(--surface-container-high) 65%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		box-shadow: 
			inset 0 0 0 1px color-mix(in srgb, var(--primary) 25%, transparent),
			inset 0 1px 0 0 color-mix(in srgb, white 20%, transparent),
			0 2px 4px color-mix(in srgb, black 6%, transparent);
		transition:
			background-color var(--m3e-duration-medium) var(--m3e-easing-standard),
			box-shadow var(--m3e-duration-medium) var(--m3e-easing-standard),
			color var(--m3e-duration-short) var(--m3e-easing-standard);
	}
	.m3-profile__link:hover {
		background: color-mix(in srgb, var(--primary) 18%, var(--surface-container-high));
		box-shadow: 
			inset 0 0 0 1px color-mix(in srgb, var(--primary) 55%, transparent),
			inset 0 1px 0 0 color-mix(in srgb, white 40%, transparent),
			0 4px 12px color-mix(in srgb, var(--primary) 20%, transparent);
	}
	@media (prefers-reduced-motion: reduce) {
		.m3-profile::before,
		.m3-profile__link {
			transition: none;
		}
	}
</style>
