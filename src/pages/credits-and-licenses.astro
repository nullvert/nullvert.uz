---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { siteConfig } from "@/config/siteConfig";

const entry = await getEntry("spec", "credits-and-licenses");

if (!entry) {
	throw new Error("Credits page content not found");
}

const isRu = (siteConfig.lang || "ru").toLowerCase().startsWith("ru");
const pageTitle = isRu ? "Лицензии и благодарности" : "Credits and Licenses";
const pageDescription = isRu
	? "Использованные на сайте материалы, лицензии и благодарности"
	: "Credits, licenses, and materials used across the site";

const { Content, remarkPluginFrontmatter } = await render(entry);
const markdownStylesheetAssets = await getMarkdownStylesheetAssets(
	remarkPluginFrontmatter.markdownSyntaxes,
);
---
<MainGridLayout title={pageTitle} description={pageDescription} page="about">
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <div class="flex w-full rounded-[var(--shape-corner-l)] overflow-hidden relative min-h-32">
        <Card color="var(--card-bg)" radius="l" class="z-10 p-6 lg:p-8 relative w-full">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </Card>
    </div>
</MainGridLayout>
