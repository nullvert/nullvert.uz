---
import BannerStage from "@components/organisms/BannerStage.astro";
import ContextMenu from "@components/organisms/ContextMenu.svelte";
import FloatingControls from "@components/organisms/FloatingControls.astro";
import Footer from "@components/organisms/Footer.astro";
import RouteProgress from "@components/organisms/RouteProgress.svelte";
import SideBar from "@components/organisms/SideBar.astro";
import SiteNavigationDrawer from "../components/organisms/SiteNavigationDrawer.svelte";
import TopAppBar from "@components/organisms/TopAppBar.astro";
import BottomMusicBar from "../components/organisms/music/BottomMusicBar.astro";
import {
	generateGridClasses,
	generateMainContentClasses,
	generatePrimarySidebarClasses,
	generateSecondarySidebarClasses,
	getResponsiveSidebarConfig,
	isDualColumn,
} from "@utils/responsive-utils";
import type { MarkdownHeading } from "astro";
import { contextMenuConfig } from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";
import Layout from "@layouts/Layout.astro";
import "../styles/theme-custom.css";

interface Props {
	title?: string;
	banner?: string;
	ogImage?: string;
	description?: string;
	/** Banner 可选日期，使用 YYYY-MM-DD 等可直接写入 time[datetime] 的值。 */
	bannerDate?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** 文章页所属分类名，透传给 CategoryBar 做弱高亮 */
	postCategory?: string;
	/** 当前页面标识符（SidebarPage），透传给 SideBar 做 pages 过滤，并输出到
	 *  #swup-container 的 data-current-page——Swup 替换容器时同步该属性，
	 *  侧栏据此在站内导航后重新过滤 */
	page?: SidebarPage | (string & {});
	hasComments?: boolean;
}

const {
	title,
	banner,
	ogImage,
	description,
	bannerDate,
	lang,
	setOGTypeArticle,
	headings = [],
	postCategory,
	page,
	hasComments,
} = Astro.props;

// 响应式侧栏配置（数据驱动布局）
const isCatalogPage = page === "anime" || (page as string) === "cinema" || (page as string) === "games";
const typedPage = (isCatalogPage ? undefined : page) as SidebarPage | undefined;
const sidebarResponsive = getResponsiveSidebarConfig();
const gridClasses = isCatalogPage ? "grid-cols-1" : generateGridClasses(sidebarResponsive);
const sidebarClasses = isCatalogPage ? "hidden" : generatePrimarySidebarClasses(sidebarResponsive);
const secondarySidebarClasses = isCatalogPage ? "hidden" : generateSecondarySidebarClasses(sidebarResponsive);
const mainContentClasses = isCatalogPage ? "col-span-1 min-w-0" : generateMainContentClasses(sidebarResponsive);
---

<Layout title={title} banner={banner} ogImage={ogImage} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} page={typedPage}>

<!-- Head inline script: синхронная проверка настроек до первого рендера -->
<script is:inline slot="head">
	if (!localStorage.getItem("theme")) {
		localStorage.setItem("theme", "dark");
		document.documentElement.classList.add("dark");
	}
	if (localStorage.getItem("shirone-music-enabled") === "false") {
		document.documentElement.dataset.music = "disabled";
	}
	if (localStorage.getItem("shirone-glass-effect") === "true") {
		document.documentElement.dataset.glass = "cards";
	}
</script>
<slot slot="head" name="head"></slot>
<header id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <TopAppBar></TopAppBar>
    </div>
</header>

<!-- Banner -->
<BannerStage page={typedPage} title={title} description={description} date={bannerDate} />

<!-- Main content -->
<div id="main-layout" class="absolute w-full z-30 pointer-events-none">
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
		<div id="main-grid" class:list={["transition duration-[var(--m3e-duration-long)] w-full left-0 right-0 grid grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4", gridClasses]}>
			<SideBar class={sidebarClasses} currentPage={typedPage} headings={headings}></SideBar>
			{isDualColumn(sidebarResponsive) && (
				<SideBar id="sidebar-secondary" column="secondary" class={secondarySidebarClasses} currentPage={typedPage} headings={headings}></SideBar>
			)}

            <!-- 主内容列：内容区随导航替换 -->
            <div id="main-content-column" class={mainContentClasses.replace("transition-swup-fade", "").trim()}>
                <main
                    id="swup-container"
                    data-current-post-category={postCategory || ""}
                    data-current-page={page}
                    data-is-catalog={isCatalogPage ? "true" : "false"}
                    data-has-comments={hasComments ? "true" : "false"}
                    data-banner-title={title || ""}
                    data-banner-description={description || ""}
                    data-banner-date={bannerDate || ""}
                    class="transition-swup-fade"
                >
                    <div id="content-wrapper" class="onload-animation">
                        <slot></slot>
                        {!isCatalogPage && (
                            <div class="footer col-span-2 onload-animation hidden lg:block">
                                <Footer></Footer>
                            </div>
                        )}
                    </div>
                </main>
            </div>

            <!-- Футер: для обычных страниц на мобилке, либо на всю ширину сетки для каталога -->
            <div id="catalog-footer-row" class={`footer col-span-2 onload-animation ${isCatalogPage ? "block w-full mt-8" : "block lg:hidden"}`}>
                <Footer></Footer>
            </div>
        </div>

        <FloatingControls page={typedPage} headings={headings} hasComments={hasComments} />
        <RouteProgress client:load />
    </div>
</div>

<script is:inline>
	function syncLayoutMode() {
		const swupContainer = document.getElementById("swup-container");
		const page = swupContainer?.dataset.currentPage;
		const isCatalogAttr = swupContainer?.dataset.isCatalog;
		const isCatalog = isCatalogAttr === "true" || page === "anime" || page === "cinema" || page === "games";

		const mainGrid = document.getElementById("main-grid");
		const sidebar = document.getElementById("sidebar");
		const sidebarSecondary = document.getElementById("sidebar-secondary");
		const mainColumn = document.getElementById("main-content-column");
		const catalogFooter = document.getElementById("catalog-footer-row");

		if (isCatalog) {
			if (mainGrid) {
				mainGrid.classList.remove("lg:grid-cols-[var(--sidebar-width)_1fr]", "lg:grid-cols-[1fr_var(--sidebar-width)]", "xl:grid-cols-[var(--sidebar-width)_1fr_var(--sidebar-width)]");
				mainGrid.classList.add("grid-cols-1");
			}
			if (sidebar) sidebar.classList.add("hidden");
			if (sidebarSecondary) sidebarSecondary.classList.add("hidden");
			if (mainColumn) {
				mainColumn.className = "col-span-1 min-w-0";
			}
			if (catalogFooter) {
				catalogFooter.className = "footer col-span-2 onload-animation block w-full mt-8";
			}
		} else {
			if (mainGrid) {
				mainGrid.classList.remove("grid-cols-1");
				mainGrid.classList.add("lg:grid-cols-[1fr_var(--sidebar-width)]");
			}
			if (sidebar) {
				sidebar.classList.remove("hidden");
			}
			if (sidebarSecondary) {
				sidebarSecondary.classList.remove("hidden");
			}
			if (mainColumn) {
				mainColumn.className = "col-span-2 lg:col-span-1 overflow-hidden min-w-0 lg:col-start-1";
			}
			if (catalogFooter) {
				catalogFooter.className = "footer col-span-2 onload-animation block lg:hidden";
			}
		}
	}

	document.addEventListener("swup:content:replace", syncLayoutMode);
	document.addEventListener("swup:page:view", syncLayoutMode);
</script>


<!-- Полноразмерный нижний стриминговый аудиоплеер в постоянной оболочке (Persistent Shell) -->
<BottomMusicBar />

<SiteNavigationDrawer client:load />
{contextMenuConfig.enable && (
	<ContextMenu
		actions={contextMenuConfig.actions}
		pages={contextMenuConfig.pages}
		client:load
	/>
)}


</Layout>
